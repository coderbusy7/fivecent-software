# development | test | production — production requires Telegram webhook secret,
# disables public /chat unless ENABLE_TEST_CHAT=true (+ Bearer ADMIN_API_TOKEN).
APP_ENV=development
ENABLE_TEST_CHAT=false

DATABASE_URL=sqlite+aiosqlite:///./fivecent.db
REDIS_URL=
QUEUE_BACKEND=inline

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=seed-phone-number-id
WHATSAPP_WABA_ID=
# Public HTTPS origin or full /webhook URL. On Render, RENDER_EXTERNAL_URL is used if this is empty.
WHATSAPP_CALLBACK_URL=
WHATSAPP_GRAPH_VERSION=v21.0

SEED_TENANT_ID=port-vauban
ADMIN_API_TOKEN=

# Single central dispatch bot (@fivecent_test_bot). Brokers onboard via single-use invites.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=fivecent_test_bot
# Required in production. Same value as secret_token when calling Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Admin UI (Streamlit). ADMIN_API_BASE points at the FastAPI service.
ADMIN_API_BASE=http://127.0.0.1:8000
ADMIN_USERNAME=
# Generate with: python -m fivecent.admin_auth
# Keep the generated single quotes when pasting into .env (the hash contains $).
ADMIN_PASSWORD_HASH=

# Seconds to wait for more inbound texts before one LLM reply. 0 disables.
DEBOUNCE_SECONDS=2.0

# Capacity / spend (ED-12, ED-13)
TENANT_RATE_LIMIT_PER_MINUTE=60
TENANT_DAILY_TOKEN_BUDGET=500000
WORKER_MAX_JOBS=10
RETENTION_MESSAGES_DAYS=365
RETENTION_INBOUND_PAYLOADS_DAYS=90
RETENTION_AUDIT_DAYS=730

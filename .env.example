DATABASE_URL=sqlite+aiosqlite:///./fivecent.db
REDIS_URL=
QUEUE_BACKEND=inline

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=seed-phone-number-id
WHATSAPP_WABA_ID=
# Public HTTPS origin or full /webhook URL. On Render, RENDER_EXTERNAL_URL is used if this is empty.
WHATSAPP_CALLBACK_URL=
WHATSAPP_GRAPH_VERSION=v21.0

SEED_TENANT_ID=port-vauban
ADMIN_API_TOKEN=

# Single central dispatch bot (@fivecent_dispatch_bot). Brokers onboard via deep link.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=fivecent_dispatch_bot
# Optional: set the same value as secret_token when calling Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Admin UI (Streamlit). ADMIN_API_BASE points at the FastAPI service.
ADMIN_API_BASE=http://127.0.0.1:8000

# Seconds to wait for more inbound texts before one LLM reply. 0 disables.
DEBOUNCE_SECONDS=2.0
